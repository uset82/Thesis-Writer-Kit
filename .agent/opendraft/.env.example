# OpenDraft Configuration
# Copy this file to .env and add your API keys

# Required: At least one AI model API key
# Default provider is gemini
MODEL_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key

# Optional: Additional models
# ANTHROPIC_API_KEY=your-claude-api-key
# OPENAI_API_KEY=your-openai-api-key
#
# OpenAI-compatible providers (e.g., OpenRouter)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=your-openai-compatible-model
# USE_PRO_FOR_VALIDATION=true
# VALIDATION_MODEL=your-validation-model
